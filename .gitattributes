# Normalize all text files to LF line endings
* text=auto eol=lf

# Explicitly declare text files
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.svg  text eol=lf

# Denote binary files
*.png  binary
*.jpg  binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
